<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.BpCare" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/white</item>

        <!-- Icon to be displayed in the center -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>

        <!-- The theme to switch to after the splash screen finishes -->
        <item name="postSplashScreenTheme">@style/Theme.BpCare</item>
    </style>

</resources>
